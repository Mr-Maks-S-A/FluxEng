# Вытянуть 300 маны из поля вокруг мага в личный запас (DRAW пополняет мага).
# Чтобы заклинание было в слоте, поменяйте Config::grimoire в SpellSim.
CASTER        # центр: x y z мага
PUSH 4        # радиус, м
PUSH 300      # сколько забрать
DRAW          # на стеке остаётся, сколько удалось забрать
DROP
HALT

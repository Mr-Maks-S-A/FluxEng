# Огненный шар: нейтральная мана -> огонь, жар и импульс. Остаток окрашен в огонь,
# поэтому вторым кастом после метеорита (огонь рядом с землёй) он дешевле.
spell Fireball ring=4 time=8
caster skill=8 tools=1.5 purity=0.9 personal=60
world  mana=300

rune s  = Target
rune c1 = Condenser power=10
rune f1 = Convert to=fire share=1
rune h1 = Heat use=0.6
rune i1 = Impulse use=1

flow   c1 -> f1 -> h1 -> i1
signal s ~> c1
